FROM node:22-slim

# System Chromium instead of Puppeteer's own bundled-browser download: avoids the flaky
# Puppeteer CDN download entirely, using Debian's already-packaged, already-verified binary.
RUN apt-get update && apt-get install -y --no-install-recommends chromium && rm -rf /var/lib/apt/lists/*
ENV CHROMIUM_PATH=/usr/bin/chromium

WORKDIR /app

COPY package*.json ./
RUN npm install

COPY . .

CMD ["sh", "-c", "npm run db:migrate && npm run db:seed && npm run start:dev"]
