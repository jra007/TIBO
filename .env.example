# Copy this file to .env and adjust for your environment.
# .env is gitignored — never commit real secrets.

# --- Postgres ---
POSTGRES_USER=tibo
POSTGRES_PASSWORD=change-me
POSTGRES_DB=tibo
POSTGRES_PORT=5434

# --- Backend ---
BACKEND_PORT=3000
# Must be a real generated secret before any non-local deployment — the backend refuses to start
# with the default when NODE_ENV=production.
JWT_SECRET=change-me
# Sets the bootstrap admin's password on first run only (ignored on later runs).
TIBO_ADMIN_PASSWORD=change-me
# Where uploaded files (appearance logo/favicon) are stored inside the backend container.
UPLOAD_DIR=/app/uploads
# Comma-separated list of origins allowed to call the API (CORS). Local dev defaults to
# http://localhost:5173,http://localhost:5174 if unset. Set this to your real domain(s) before
# any non-local deployment — see README's "Déploiement derrière un reverse-proxy" section.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# --- Frontend ---
FRONTEND_PORT=5174
# Full URL the browser uses to reach the backend API. Local dev: http://localhost:3000.
# Behind a reverse proxy sharing one domain with the frontend: see README's
# "Déploiement derrière un reverse-proxy" section (needs a /api path + rewrite rule).
VITE_API_BASE_URL=http://localhost:3000

# --- Relation-detection service ---
RELATION_DETECTION_PORT=8001
